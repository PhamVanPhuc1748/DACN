# PigSkinTech Desktop App Configuration Template (.env.example)
# Copy this file to PigSkinTech/.env and fill in credentials locally.

DATABASE_ENGINE=sqlserver
DB_SERVER=localhost
DB_NAME=PigSkinTechDB
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=PigSkinTechDB
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
Trusted_Connection=yes
SQLSERVER_TRUSTED_CONNECTION=true

# Google OAuth 2.0 Desktop Flow
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/callback

# Gemini AI Veterinary Chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible / Ollama Fallback
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Enable quick login and seed missing demo accounts in a test database.
PIGSKIN_DEMO_MODE=false
PIGSKIN_DEMO_PASSWORD=
