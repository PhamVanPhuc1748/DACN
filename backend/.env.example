# PigSkin API configuration template.
# Copy this file to backend/.env and replace values locally.
# Do not commit backend/.env or put credentials in source code.

# Active storage remains SQLite until backend/app/database.py is migrated.
PIGSKIN_DATABASE_BACKEND=sqlite
PIGSKIN_SQLITE_PATH=pigskin.db

# SQL Server connection settings for the planned database adapter.
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=PigSkinDB
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_TRUSTED_CONNECTION=false
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
SQLSERVER_TIMEOUT_SECONDS=30

# AI chat provider. Use provider's OpenAI-compatible API endpoint.
# For Ollama, for example: AI_PROVIDER=ollama and AI_BASE_URL=http://localhost:11434/v1
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=700
# Optional: override the safe Vietnamese default in app/config.py.
AI_SYSTEM_PROMPT=
